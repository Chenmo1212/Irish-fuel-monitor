# --- Telegram notifications (set notification.source: telegram in config.yaml) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: override the Telegram API base URL with a Cloudflare Worker reverse proxy.
# Useful when api.telegram.org is blocked (e.g. from a China VPS).
# The Worker should restrict routing to /bot<TOKEN>/sendMessage only.
# Example: TELEGRAM_API_BASE=
TELEGRAM_API_BASE=

# --- Custom HTTP API (legacy, set notification.source: fuel-monitor) ---
NOTIFICATION_API_URL=https://api.chenmo1212.cn/message/entries
# Optional: sent as "Authorization: Bearer <key>" if set
NOTIFICATION_API_KEY=

# --- Multi-user bot ---
# Your own Telegram chat ID — gates the /admin command
ADMIN_CHAT_ID=
